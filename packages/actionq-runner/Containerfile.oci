FROM docker.io/library/python@sha256:cab2dbf575e971934a81e4622f5aba17aa7929719bd7e31033a3a83b97fd0464

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git=1:2.47.3-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 runner \
    && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /nonexistent runner

COPY packages/actionq-runner/actionq_runner/oci_wrapper.py /usr/local/lib/actionq-oci-wrapper.py
RUN chmod 0555 /usr/local/lib/actionq-oci-wrapper.py

USER 1000:1000
WORKDIR /workspace
